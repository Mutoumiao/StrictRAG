# StrictRAG 环境变量示例（骨架；对齐 partner 的 APP_ENV / API_BASE_URL 习惯）
# 复制为 .env 后填写。密钥禁止提交，禁止进入 apps/web|admin 客户端打包。

NODE_ENV=development
APP_ENV=development

# API（Node Hono 目标端口 4000）
API_BASE_URL=http://127.0.0.1:4000
PORT=4000

# 前端公开变量（仅非密钥）
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# PostgreSQL
DATABASE_URL=postgresql://strict_rag:strict_rag@127.0.0.1:5432/strict_rag

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Phase 0+ 再启用
# JWT_SECRET=
# RERANK_MIN_NODES=1
# MODEL_GATEWAY_BASE_URL=
