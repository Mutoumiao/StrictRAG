# StrictRAG 本地开发环境变量（复制为 .env，勿提交密钥）
# 规格：Phase 0 env Zod · tauClaim 唯一源 · Gateway 仅服务端

# --- 通用 ---
APP_ENV=development
LOG_LEVEL=info

# --- PostgreSQL（compose 默认）---
DATABASE_URL=postgres://strict_rag:strict_rag@127.0.0.1:5432/strict_rag

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- API ---
API_PORT=4000
# 声明验证唯一门槛（服务端唯一源；禁止客户端 options / 双源）
TAU_CLAIM=0.5
# 若设置 TAU_CLAIM_LEGACY 且与 TAU_CLAIM 不同 → 启动失败（防双源）
# TAU_CLAIM_LEGACY=

# --- Worker ---
# 启动时自投递探针 job（默认 true）
WORKER_PROBE_ON_START=true

# --- 模型 Gateway（仅服务端；P0 可空，探针会 skipped）---
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# --- 入库 P1 ---
INGEST_MAX_FILE_BYTES=52428800
INGEST_MAX_FILE_BYTES_CEILING=209715200
INGEST_SCAN_MODE=mock_clean
INGEST_ES_MODE=mock
INGEST_EMBED_MODE=mock
INGEST_MIN_EXTRACTED_CHARS=40
STORAGE_MODE=local
STORAGE_LOCAL_DIR=.data/objects
S3_BUCKET=strict-rag

# --- 可选依赖（P1+；ready 未配置则 skipped）---
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# MONGODB_URL=mongodb://127.0.0.1:27017/strict_rag
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=strict_rag
# S3_SECRET_KEY=strict_rag_secret

# --- 身份（过渡双 JWT；prod 必须改密钥）---
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
# true：业务路由逐步强制登录；false：Phase1 demo-ingest 可无鉴权
AUTH_ENFORCE=false

# --- 前端 public（禁止放密钥）---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
