# StrictRAG 可运行叠加（HALF-ENV）
# 用法：复制本文件内容追加进仓库根 `.env`（在 `.env.example` 默认 mock 之上覆盖）。
# 本文件 **不是** CI / Zod 默认。仓库默认仍 mock + local + AUTH_ENFORCE=false。
# 对照：docs/ops/operable-stack.md

INGEST_ES_MODE=http
RETRIEVE_ES_MODE=http
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTIC_INDEX=strict_rag_dev

STORAGE_MODE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=strict_rag
S3_SECRET_KEY=strict_rag_secret
S3_BUCKET=strict-rag
# 凭证与 compose rustfs 的 RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY 对齐

MONGODB_URL=mongodb://127.0.0.1:27017/strict_rag

# 扫描仍 mock（development only）。禁止 on。
INGEST_SCAN_MODE=mock_clean

# 向量默认仍 mock。真向量见 HALF-EMBED + Gateway。
INGEST_EMBED_MODE=mock

# 仓库默认鉴权关。试点打开见 HALF-AUTHDOC，勿在本叠加改 true。
AUTH_ENFORCE=false
DEPT_ACL_ENFORCE=false
SESSION_REWRITE_ENABLED=false
