{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "APP_ENV",
        "API_BASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "APP_ENV",
        "API_BASE_URL",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_API_BASE_URL",
        "L1_KB_ID",
        "L1_MAX_CASES",
        "L1_TENANT_ID",
        "L1_USER_ID",
        "L1_GOLD_PATH",
        "L1_OUT_DIR"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["APP_ENV", "API_BASE_URL", "NEXT_PUBLIC_APP_ENV", "NEXT_PUBLIC_API_BASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ENV",
        "API_BASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_API_BASE_URL"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/**"],
      "env": [
        "APP_ENV",
        "DATABASE_URL",
        "REDIS_URL",
        "TAU_CLAIM",
        "NODE_ENV",
        "L1_KB_ID",
        "L1_MAX_CASES",
        "L1_TENANT_ID",
        "L1_USER_ID",
        "L1_GOLD_PATH",
        "L1_OUT_DIR"
      ]
    }
  }
}
